{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"isolatedDeclarations": false,
		"declaration": false,
		"types": ["node"],
		// Node runs the scripts as they are, so they import each other by their
		// `.ts` names and use only syntax that Node can strip.
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true
	},
	"include": [
		"vite.config.ts",
		"scripts",
		"packages/ml-dsa/vite.config.ts",
		"packages/ml-dsa/wasm-imports.ts"
	]
}
