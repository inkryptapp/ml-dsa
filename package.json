{
	"name": "ml-dsa-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "vp config --hooks --no-agent",
		"check": "vp check",
		"lint": "vp lint",
		"typecheck": "tsc -p tsconfig.json && tsc -p packages/ml-dsa && tsc -p packages/ml-dsa/test && tsc -p packages/ml-dsa/check",
		"test": "vp test run",
		"coverage": "vp test run --coverage packages/ml-dsa/test/exit-matrix.test.ts"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@tsconfig/strictest": "2.0.8",
		"@types/node": "22.20.5",
		"@vitest/coverage-v8": "5.0.5",
		"typescript": "7.0.2",
		"typescript-5.7": "npm:typescript@5.7.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
		"vite-plus": "1.3.0",
		"yaml": "2.9.1",
		"zod": "4.6.7"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^22.22.1 || ^24.11.0 || >=26.0.0",
			"onFail": "error"
		}
	},
	"packageManager": "pnpm@12.16.1"
}
