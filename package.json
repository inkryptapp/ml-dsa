{
  "name": "@inkrypt/ml-dsa",
  "version": "0.0.0",
  "description": "ML-DSA-87 (FIPS 204) from mldsa-native, compiled to WebAssembly.",
  "license": "Apache-2.0 OR MIT",
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp native/vendor/mldsa-native/LICENSE dist/LICENSE-mldsa-native",
    "prepack": "pnpm build",
    "build:wasm": "sh scripts/build-wasm.sh",
    "vendor": "cd native && ../scripts/nix run path:.#vendor",
    "check": "sh scripts/check.sh",
    "vectors": "node scripts/fetch-acvp-vectors.mjs",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:matrix": "node scripts/browser-matrix.mjs",
    "bench": "vitest run --config vitest.bench.config.ts"
  },
  "devDependencies": {
    "@noble/post-quantum": "0.7.1",
    "@puppeteer/browsers": "3.2.3",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/browser-webdriverio": "5.0.0",
    "es-module-lexer": "2.3.2",
    "fast-check": "4.10.2",
    "lint-staged": "17.6.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "webdriverio": "9.32.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "lint-staged": {
    "*": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "packageManager": "pnpm@12.8.1"
}
